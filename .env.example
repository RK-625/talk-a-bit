# Copy to .env (git-ignored) and fill in. Used only by server-side code: the Vite dev-server classifier proxy (vite.config.js -> server/jev.js) and `npm run jev:eval`.
JEV_API_KEY=your-jev-api-key
# optional: JEV_MODEL=jev-latest

